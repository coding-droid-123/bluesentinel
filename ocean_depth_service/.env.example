# OpenTopography API Key (register for free at https://portal.opentopography.org/)
OT_API_KEY=your_opentopography_api_key_here

# Comma-separated list of valid client API keys
APP_API_KEYS=secret_client_key_1,secret_client_key_2

# Bounding box pad in degrees around the target coordinate (default: 0.02)
DEPTH_PAD=0.02

# Server Port (optional, defaults to 8000)
PORT=8000
